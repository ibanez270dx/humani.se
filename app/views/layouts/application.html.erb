<!DOCTYPE html>
<html lang="en">
  <head>
    <% page_title = content_for(:title).presence || "Jeff Miller · Engineering Leader | humani.se" %>
    <% page_description = "I’m Jeff Miller, a VP of Engineering in Carlsbad, California. I build teams, useful software, and thoughtful ways to put AI to work." %>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= page_description %>">
    <link rel="canonical" href="https://www.humani.se/">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="humani.se">
    <meta property="og:locale" content="en_US">
    <meta property="og:url" content="https://www.humani.se/">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:image" content="https://www.humani.se/social-preview.jpg">
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Jeff Miller, VP of Engineering — an engineering leader who still loves building things.">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= page_description %>">
    <meta name="twitter:image" content="https://www.humani.se/social-preview.jpg">
    <meta name="twitter:image:alt" content="Jeff Miller, VP of Engineering — an engineering leader who still loves building things.">
    <meta name="theme-color" content="#071523">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
    <link rel="icon" type="image/png" href="/favicon-16.png" sizes="16x16">
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32">
    <link rel="icon" type="image/png" href="/favicon-48.png" sizes="48x48">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any">
    <link rel="apple-touch-icon" href="/favicon-180.png" sizes="180x180">
    <%= stylesheet_link_tag "application" %>
  </head>
  <body>
    <div class="night-sky" aria-hidden="true">
      <%= image_tag "background/1440.webp",
        srcset: { "background/640.webp" => "640w", "background/960.webp" => "960w", "background/1440.webp" => "1440w", "background/2560.webp" => "2560w", "background/3200.webp" => "3200w" },
        sizes: "100vw", alt: "", fetchpriority: "high" %>
      <%= render "application/twinkling_stars" %>
    </div>
    <%= link_to "Skip to content", "#main-content", class: "skip-link" %>
    <header class="site-header">
      <%= link_to "humani.se", root_path, class: "wordmark", aria: { label: "humani.se — home" } %>
      <nav class="header-links" aria-label="Main navigation">
        <%= link_to "/jeff-miller-resume.pdf", target: "_blank", rel: "noopener" do %>
          Resume <span aria-hidden="true">↗</span><span class="visually-hidden"> (PDF, opens in a new tab)</span>
        <% end %>
        <%= link_to "https://calendly.com/jeff-dev/meeting", target: "_blank", rel: "noopener noreferrer" do %>
          Let’s chat <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span>
        <% end %>
      </nav>
    </header>
    <main id="main-content" tabindex="-1">
      <%= yield %>
    </main>
    <footer class="site-footer">© <%= Date.current.year %> Jeff Miller</footer>
  </body>
</html>
