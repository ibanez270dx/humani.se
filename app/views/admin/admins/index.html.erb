<h1>Admins</h1>
<p>Approve Google accounts that can access this site. Only you, the owner, can manage access.</p>
<article>
  <h2>Invite an admin</h2>
  <% if @admin.errors.any? %>
    <div role="alert"><%= @admin.errors.full_messages.to_sentence %></div>
  <% end %>
  <%= form_with model: @admin, url: admin_admins_path do |form| %>
    <%= form.label :email, "Google account email" %>
    <%= form.email_field :email, required: true, autocomplete: "email" %>
    <small>No email is sent. Share https://admin.humani.se with the person you invite.</small>
    <%= form.submit "Add admin" %>
  <% end %>
</article>
<div class="overflow-auto" role="region" aria-label="Admin accounts" tabindex="0">
  <table>
    <caption>Accounts with current or previous access</caption>
    <thead><tr><th scope="col">Account</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col">Last sign-in</th><th scope="col">Access</th></tr></thead>
    <tbody>
      <% @admins.each do |admin| %>
        <tr>
          <th scope="row"><%= admin.email %><% if admin.name.present? %><br><small><%= admin.name %></small><% end %></th>
          <td><%= admin.role.capitalize %></td>
          <td><%= admin.access_status %></td>
          <td><%= admin.last_signed_in_at&.utc&.strftime("%b %-d, %Y %H:%M UTC") || "Never" %></td>
          <td>
            <% if admin.owner? %>
              Owner account
            <% else %>
              <%= button_to admin.active? ? "Revoke access" : "Restore access", admin_admin_path(admin), method: :patch, params: { access: admin.active? ? "revoke" : "restore" }, class: "secondary outline", aria: { label: "#{admin.active? ? 'Revoke' : 'Restore'} access for #{admin.email}" } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
